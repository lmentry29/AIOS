      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "lifecycle_substate"
            ]
          },
          "then": {
            "properties": {
              "lifecycle_state": {
                "const": "active"
              },
              "lifecycle_substate": {
                "enum": [
                  "mutating",
                  "persisting",
                  "synchronizing"
                ]
              }
            }
          }
        },
        {
          "properties": {
            "lifecycle_history": {
              "items": {
                "if": {
                  "required": [
                    "substate"
                  ]
                },
                "then": {
                  "properties": {
                    "state": {
                      "const": "active"
                    },
                    "substate": {
                      "enum": [
                        "mutating",
                        "persisting",
                        "synchronizing"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      ],
      "properties": {
