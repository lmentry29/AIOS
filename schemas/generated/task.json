{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "task",
  "definitions": {
    "Action": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "format": "uuid",
          "type": "string"
        },
        "executed_by": {
          "format": "uuid",
          "type": "string"
        },
        "status": {
          "enum": [
            "pending",
            "executing",
            "completed",
            "failed"
          ],
          "type": "string"
        }
      },
      "required": [
        "action_id",
        "status",
        "executed_by"
      ],
      "type": "object"
    },
    "ActionStatus": {
      "enum": [
        "pending",
        "executing",
        "completed",
        "failed"
      ],
      "type": "string"
    },
    "TaskEntity": {
      "additionalProperties": false,
      "allOf": [
        {
          "not": {
            "required": [
              "lifecycle_substate"
            ]
          }
        },
        {
          "not": {
            "properties": {
              "lifecycle_history": {
                "contains": {
                  "required": [
                    "substate"
                  ]
                }
              }
            }
          }
        }
      ],
      "properties": {
        "access_policy": {
          "format": "uuid",
          "type": "string"
        },
        "actions": {
          "default": [],
          "items": {
            "additionalProperties": false,
            "properties": {
              "action_id": {
                "format": "uuid",
                "type": "string"
              },
              "executed_by": {
                "format": "uuid",
                "type": "string"
              },
              "status": {
                "enum": [
                  "pending",
                  "executing",
                  "completed",
                  "failed"
                ],
                "type": "string"
              }
            },
            "required": [
              "action_id",
              "status",
              "executed_by"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "assigned_agent": {
          "format": "uuid",
          "type": "string"
        },
        "assigned_workflow": {
          "format": "uuid",
          "type": "string"
        },
        "audit_trail_ref": {
          "format": "uuid",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "created_by": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "entity_id": {
          "format": "uuid",
          "type": "string"
        },
        "entity_subtype": {
          "type": "string"
        },
        "entity_type": {
          "const": "task",
          "type": "string"
        },
        "execution": {
          "additionalProperties": false,
          "properties": {
            "argv": {
              "items": {
                "maxLength": 4096,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 64,
              "minItems": 1,
              "type": "array"
            },
            "cwd": {
              "maxLength": 1024,
              "type": "string"
            },
            "env": {
              "additionalProperties": {
                "maxLength": 256,
                "type": "string"
              },
              "type": "object"
            },
            "kind": {
              "const": "local_command",
              "type": "string"
            },
            "max_output_bytes": {
              "maximum": 1048576,
              "minimum": 1024,
              "type": "integer"
            },
            "timeout_ms": {
              "maximum": 300000,
              "minimum": 100,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "argv"
          ],
          "type": "object"
        },
        "lifecycle_history": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "actor": {
                "type": "string"
              },
              "entered_at": {
                "format": "date-time",
                "type": "string"
              },
              "state": {
                "enum": [
                  "created",
                  "validated",
                  "active",
                  "monitored",
                  "suspended",
                  "completed",
                  "archived"
                ],
                "type": "string"
              },
              "substate": {
                "type": "string"
              }
            },
            "required": [
              "state",
              "entered_at",
              "actor"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "lifecycle_state": {
          "enum": [
            "created",
            "validated",
            "active",
            "monitored",
            "suspended",
            "completed",
            "archived"
          ],
          "type": "string"
        },
        "lifecycle_substate": {
          "type": "string"
        },
        "modified_at": {
          "format": "date-time",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "organizational_containers": {
          "default": [],
          "items": {
            "additionalProperties": false,
            "properties": {
              "container_type": {
                "enum": [
                  "project",
                  "program",
                  "release",
                  "milestone",
                  "epic",
                  "feature",
                  "roadmap",
                  "vision",
                  "workspace"
                ],
                "type": "string"
              },
              "entity_id": {
                "format": "uuid",
                "type": "string"
              }
            },
            "required": [
              "entity_id",
              "container_type"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "owner_id": {
          "type": "string"
        },
        "owner_type": {
          "enum": [
            "agent",
            "human"
          ],
          "type": "string"
        },
        "relationships": {
          "default": [],
          "items": {
            "additionalProperties": false,
            "properties": {
              "direction": {
                "enum": [
                  "outbound",
                  "inbound"
                ],
                "type": "string"
              },
              "relationship_type": {
                "type": "string"
              },
              "target_entity_id": {
                "format": "uuid",
                "type": "string"
              },
              "target_entity_type": {
                "enum": [
                  "agent",
                  "task",
                  "workflow",
                  "plugin",
                  "canonical_object"
                ],
                "type": "string"
              }
            },
            "required": [
              "target_entity_id",
              "target_entity_type",
              "relationship_type",
              "direction"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "verification": {
          "additionalProperties": false,
          "properties": {
            "argv": {
              "items": {
                "maxLength": 4096,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 64,
              "minItems": 1,
              "type": "array"
            },
            "cwd": {
              "maxLength": 1024,
              "type": "string"
            },
            "expected_exit_code": {
              "default": 0,
              "maximum": 255,
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "local_command",
              "type": "string"
            },
            "timeout_ms": {
              "maximum": 300000,
              "minimum": 100,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "argv"
          ],
          "type": "object"
        },
        "version": {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        "work_hierarchy_parent": {
          "additionalProperties": false,
          "properties": {
            "entity_id": {
              "format": "uuid",
              "type": "string"
            },
            "level": {
              "const": "objective",
              "type": "string"
            }
          },
          "required": [
            "entity_id",
            "level"
          ],
          "type": "object"
        }
      },
      "required": [
        "entity_id",
        "entity_type",
        "name",
        "lifecycle_state",
        "lifecycle_history",
        "created_at",
        "created_by",
        "modified_at",
        "version",
        "work_hierarchy_parent",
        "owner_id",
        "owner_type"
      ],
      "type": "object"
    },
    "TaskExecutionSpec": {
      "additionalProperties": false,
      "properties": {
        "argv": {
          "items": {
            "maxLength": 4096,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "type": "array"
        },
        "cwd": {
          "maxLength": 1024,
          "type": "string"
        },
        "env": {
          "additionalProperties": {
            "maxLength": 256,
            "type": "string"
          },
          "type": "object"
        },
        "kind": {
          "const": "local_command",
          "type": "string"
        },
        "max_output_bytes": {
          "maximum": 1048576,
          "minimum": 1024,
          "type": "integer"
        },
        "timeout_ms": {
          "maximum": 300000,
          "minimum": 100,
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "argv"
      ],
      "type": "object"
    },
    "TaskVerificationSpec": {
      "additionalProperties": false,
      "properties": {
        "argv": {
          "items": {
            "maxLength": 4096,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "type": "array"
        },
        "cwd": {
          "maxLength": 1024,
          "type": "string"
        },
        "expected_exit_code": {
          "default": 0,
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "kind": {
          "const": "local_command",
          "type": "string"
        },
        "timeout_ms": {
          "maximum": 300000,
          "minimum": 100,
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "argv"
      ],
      "type": "object"
    }
  }
}
