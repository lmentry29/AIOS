{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "objective",
  "definitions": {
    "ObjectiveEntity": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "lifecycle_substate"
            ]
          },
          "then": {
            "properties": {
              "lifecycle_state": {
                "const": "active"
              },
              "lifecycle_substate": {
                "enum": [
                  "mutating",
                  "persisting",
                  "synchronizing"
                ]
              }
            }
          }
        },
        {
          "properties": {
            "lifecycle_history": {
              "items": {
                "if": {
                  "required": [
                    "substate"
                  ]
                },
                "then": {
                  "properties": {
                    "state": {
                      "const": "active"
                    },
                    "substate": {
                      "enum": [
                        "mutating",
                        "persisting",
                        "synchronizing"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      ],
      "properties": {
        "acceptance_criteria": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "access_policy": {
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "type": "string"
        },
        "audit_trail_ref": {
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "type": "string"
        },
        "constraints": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "created_at": {
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
          "type": "string"
        },
        "created_by": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "desired_outcome": {
          "type": "string"
        },
        "entity_id": {
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "type": "string"
        },
        "entity_subtype": {
          "const": "objective",
          "type": "string"
        },
        "entity_type": {
          "const": "canonical_object",
          "type": "string"
        },
        "known_unknowns": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "lifecycle_history": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "actor": {
                "type": "string"
              },
              "entered_at": {
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
                "type": "string"
              },
              "state": {
                "enum": [
                  "created",
                  "validated",
                  "active",
                  "monitored",
                  "suspended",
                  "completed",
                  "archived"
                ],
                "type": "string"
              },
              "substate": {
                "type": "string"
              }
            },
            "required": [
              "state",
              "entered_at",
              "actor"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "lifecycle_state": {
          "enum": [
            "created",
            "validated",
            "active",
            "monitored",
            "suspended",
            "completed",
            "archived"
          ],
          "type": "string"
        },
        "lifecycle_substate": {
          "type": "string"
        },
        "modified_at": {
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "organizational_containers": {
          "default": [],
          "items": {
            "additionalProperties": false,
            "properties": {
              "container_type": {
                "enum": [
                  "project",
                  "program",
                  "release",
                  "milestone",
                  "epic",
                  "feature",
                  "roadmap",
                  "vision",
                  "workspace"
                ],
                "type": "string"
              },
              "entity_id": {
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                "type": "string"
              }
            },
            "required": [
              "entity_id",
              "container_type"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "owner_id": {
          "type": "string"
        },
        "owner_type": {
          "enum": [
            "agent",
            "human"
          ],
          "type": "string"
        },
        "priority": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ],
          "type": "string"
        },
        "purpose": {
          "type": "string"
        },
        "relationships": {
          "default": [],
          "items": {
            "additionalProperties": false,
            "properties": {
              "direction": {
                "enum": [
                  "outbound",
                  "inbound"
                ],
                "type": "string"
              },
              "relationship_type": {
                "type": "string"
              },
              "target_entity_id": {
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                "type": "string"
              },
              "target_entity_type": {
                "enum": [
                  "agent",
                  "task",
                  "workflow",
                  "plugin",
                  "canonical_object"
                ],
                "type": "string"
              }
            },
            "required": [
              "target_entity_id",
              "target_entity_type",
              "relationship_type",
              "direction"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "risk_profile": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ],
          "type": "string"
        },
        "success_criteria": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "version": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "work_hierarchy_parent": {
          "additionalProperties": false,
          "properties": {
            "entity_id": {
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "type": "string"
            },
            "level": {
              "enum": [
                "mission",
                "objective",
                "task"
              ],
              "type": "string"
            }
          },
          "required": [
            "entity_id",
            "level"
          ],
          "type": "object"
        }
      },
      "required": [
        "entity_id",
        "entity_type",
        "entity_subtype",
        "name",
        "lifecycle_state",
        "lifecycle_history",
        "created_at",
        "created_by",
        "modified_at",
        "version",
        "owner_id",
        "owner_type",
        "purpose",
        "desired_outcome",
        "success_criteria",
        "priority",
        "risk_profile",
        "acceptance_criteria"
      ],
      "type": "object"
    },
    "ObjectivePriority": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "type": "string"
    },
    "ObjectiveRiskProfile": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "type": "string"
    }
  }
}
